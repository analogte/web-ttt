# Environment Variables for Thailand Travel Guide
# Copy this file to .env.local and fill in your values

# TAT Open Data API Key (required)
# Get your API key from: https://tatapi.tourismthailand.org/
TAT_API_KEY=your_tat_api_key_here

# Resend API Key (optional - for contact form emails)
# Sign up at: https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email to receive contact form submissions
CONTACT_EMAIL=your-email@example.com
